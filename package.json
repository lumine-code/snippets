{
  "name": "snippets",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Expand snippets matching the current prefix with the tab key.",
  "keywords": [
    "template",
    "expansion",
    "tab-stop",
    "completion",
    "textmate"
  ],
  "repository": "https://github.com/lumine-code/snippets",
  "bugs": {
    "url": "https://github.com/lumine-code/snippets/issues"
  },
  "license": "MIT",
  "main": "./lib/snippets",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "autocomplete"
  ],
  "configSchema": {
    "enableAutocomplete": {
      "title": "Autocomplete Suggestions",
      "description": "Offer snippets in the autocomplete list while keeping prefix expansion available independently.",
      "type": "boolean",
      "default": true
    }
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parse": "peggy -o ./lib/snippet-body.js ./lib/snippet-body.pegjs"
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    },
    "snippets": {
      "description": "Snippets are text shortcuts that can be expanded to their definition.",
      "versions": {
        "1.0.0": "provideSnippets"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/season": "github:lumine-code/season#b0212a0b99cdece50552c5ea8e30919402bb1b3f",
    "@lumine-code/selector-store": "github:lumine-code/selector-store#b893d50bb02e801ba794c6954c5dddb7766ec489",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#649efa71eda93df22e2e5cb61a22d65fb17654b1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#49c48134ee6e25f8fa2391b41d2151c8f24e3ca2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.9"
  }
}
