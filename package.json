{
  "name": "snippets",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Expand snippets matching the current prefix with the tab key.",
  "keywords": [
    "template",
    "expansion",
    "tab-stop",
    "completion",
    "textmate"
  ],
  "repository": "https://github.com/lumine-code/snippets",
  "bugs": {
    "url": "https://github.com/lumine-code/snippets/issues"
  },
  "license": "MIT",
  "main": "./lib/snippets",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can expand a snippet by typing its prefix and pressing {{ 'snippets:expand' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parse": "peggy -o ./lib/snippet-body.js ./lib/snippet-body.pegjs"
  },
  "providedServices": {
    "snippets": {
      "description": "Snippets are text shortcuts that can be expanded to their definition.",
      "versions": {
        "1.0.0": "provideSnippets"
      }
    }
  },
  "dependencies": {
    "@lumine-code/season": "github:lumine-code/season#b9d78e669eff982a40e0e71a9b6ccbcc8c2d9519",
    "@lumine-code/selector-store": "github:lumine-code/selector-store#45a202d664476e0ff0ef17d2091eb43cd77a4bfa",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#7abe38681700c81e6e69a53fbd2c9fd2835ff066",
    "async": "3.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "github:lumine-code/node-temp#2a0b2ce5f1c90a8041f6043cfe52d75ceadb364d",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.6"
  }
}
