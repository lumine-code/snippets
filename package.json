{
  "name": "snippets",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Expand snippets matching the current prefix with the tab key.",
  "keywords": [
    "template",
    "expansion",
    "tab-stop",
    "completion",
    "textmate"
  ],
  "repository": "https://github.com/lumine-code/snippets",
  "bugs": {
    "url": "https://github.com/lumine-code/snippets/issues"
  },
  "license": "MIT",
  "main": "./lib/snippets",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can expand a snippet by typing its prefix and pressing {{ 'snippets:expand' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parse": "peggy -o ./lib/snippet-body.js ./lib/snippet-body.pegjs"
  },
  "providedServices": {
    "snippets": {
      "description": "Snippets are text shortcuts that can be expanded to their definition.",
      "versions": {
        "1.0.0": "provideSnippets"
      }
    }
  },
  "dependencies": {
    "@lumine-code/season": "github:lumine-code/season#556c9582ff3f3cb5d99e831f49424081ee19e0f8",
    "@lumine-code/selector-store": "github:lumine-code/selector-store#3fcab5897743d17d668fdf17e8d60325ec57ac28",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#02d71a75193a1098c5f59d8ea7656a815ee3d712",
    "async": "3.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "github:lumine-code/node-temp#bbd9e24a78e835e7421c8acec360731eafa4d3f6",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.6"
  }
}
