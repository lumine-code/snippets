{
  "name": "snippets",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Expand snippets matching the current prefix with the tab key.",
  "keywords": [
    "template",
    "expansion",
    "tab-stop",
    "completion",
    "textmate"
  ],
  "repository": "https://github.com/lumine-code/snippets",
  "bugs": {
    "url": "https://github.com/lumine-code/snippets/issues"
  },
  "license": "MIT",
  "main": "./lib/snippets",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "autocomplete"
  ],
  "configSchema": {
    "enableAutocomplete": {
      "title": "Autocomplete Suggestions",
      "description": "Offer snippets in the autocomplete list while keeping prefix expansion available independently.",
      "type": "boolean",
      "default": true
    }
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parse": "peggy -o ./lib/snippet-body.js ./lib/snippet-body.pegjs"
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    },
    "snippets": {
      "description": "Snippets are text shortcuts that can be expanded to their definition.",
      "versions": {
        "1.0.0": "provideSnippets"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/season": "github:lumine-code/season#2e97425536e870be5a875f7319b8cb5413d3b87d",
    "@lumine-code/selector-store": "github:lumine-code/selector-store#080b3ecc61d00ea73f6ffe78762a2a76b3b7fef8",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#b93d01acfb57ce4e40296a7de2ef2dcc1f6442f5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#1a6b777f19f970a351ce227f4b2acd096546878a",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "peggy": "^5.1.1",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.4"
    }
  }
}
